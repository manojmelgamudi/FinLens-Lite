# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# GAS_WEB_APP_URL: Deployed Google Apps Script Web App URL (Execute as: Me, Access: Anyone).
GAS_WEB_APP_URL=""

# GAS_API_SECRET: Shared secret configured in Google Apps Script ScriptProperties (API_SECRET).
GAS_API_SECRET=""

# FINANCE_RECOVERY_KEY: Optional owner recovery key for resetting PIN via protected recovery flow.
FINANCE_RECOVERY_KEY=""

# Optional: Only needed if hosting the static frontend separately from the Express backend.
VITE_API_BASE_URL=""
CORS_ORIGIN=""
